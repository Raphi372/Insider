# Kopiere diese Datei nach ".env" und trage deine Werte ein.
# Die .env enthält Geheimnisse und wird nicht ins Git übernommen.

# --- sec-api.io ---------------------------------------------------------------
# Schlüssel aus dem Dashboard. Zum Ausprobieren genügt der kostenlose Schlüssel
# (100 Abrufe insgesamt, ohne Stream); für den Dauerbetrieb braucht es einen
# Tarif mit Stream-API ("Personal & Startups").
SEC_API_KEY=

# --- Anthropic (Claude) -------------------------------------------------------
# platform.claude.com -> Settings -> API Keys (beginnt mit sk-ant-)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-5-5

# --- Telegram ------------------------------------------------------------------
# Token von @BotFather (/newbot), eigene ID von @userinfobot.
# Wichtig: dem Bot einmal /start schreiben, sonst darf er dir nichts senden.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# --- Interactive Brokers (nur Paper-Trading) ----------------------------------
# Kontonummer des Paper-Kontos (beginnt mit "D", z. B. DU1234567).
# Andere Konten lehnt der Workflow ab.
IBKR_ACCOUNT_ID=
# Benutzername und Passwort des PAPER-Trading-Logins. Damit meldet sich das
# Gateway selbst an und erneuert die Sitzung automatisch.
IBEAM_ACCOUNT=
IBEAM_PASSWORD=
# Startet das mitgelieferte IBKR-Gateway. Leer lassen, solange du kein
# IBKR-Konto eingerichtet hast – die Meldungen kommen dann ohne Order-Button –
# oder wenn du ein eigenes Gateway betreibst (dann IBKR_BASE_URL in
# docker-compose.yml anpassen).
COMPOSE_PROFILES=ibkr

# --- Interne Absicherung -------------------------------------------------------
# Beliebige lange Zufallszeichenfolge. Schützt die n8n-Webhooks, über die
# Orders ausgelöst werden. Erzeugen z. B. mit: openssl rand -hex 32
BRIDGE_SECRET=

# --- Strategie -----------------------------------------------------------------
# Nur Käufe ab diesem Gesamtwert in US-Dollar werden gemeldet (Aktien × Preis,
# alle Teilkäufe einer Meldung zusammen). Gespeichert wird jede Meldung.
MIN_PURCHASE_VALUE_USD=25000
# Cluster: So viele Tage zurück zählen Käufe anderer Insider desselben Unternehmens.
CLUSTER_DAYS=14
# Verkaufswarnung, wenn ein Insider verkauft, dessen Kauf dir gemeldet wurde:
#   orders  – nur, wenn du zu diesem Kauf die Order gesendet hattest
#   signals – bei jedem gemeldeten Kauf
#   off     – nie
SELL_ALERT_SCOPE=orders
# So viele Tage nach dem gemeldeten Kauf wird noch gewarnt.
SELL_ALERT_LOOKBACK_DAYS=365
# Ordergröße: Budget in USD je Signal (Stückzahl = Budget / Limitpreis) ...
ORDER_BUDGET_USD=5000
# ... oder feste Stückzahl. Ist hier eine Zahl > 0 gesetzt, hat sie Vorrang.
ORDER_QUANTITY=
# Abstand von Stop-Loss und Take-Profit zum Limitpreis in Prozent.
STOP_LOSS_PCT=8
TAKE_PROFIT_PCT=15
# Danach ist der "Order senden"-Button einer Nachricht wirkungslos.
ORDER_BUTTON_MAX_AGE_HOURS=24

# --- Sonstiges -----------------------------------------------------------------
TZ=Europe/Berlin
